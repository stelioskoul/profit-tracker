# Server-only Supabase Postgres session-pooler URL (copy host from Supabase > Connect).
# Use the dedicated beprofit_app role, NOT the postgres owner; never expose this to Vite.
DATABASE_URL=postgresql://beprofit_app.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Strong random 32+ character value used to sign sessions and provider OAuth state.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Base64-encoded 32 random bytes (generate once and back up securely).
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET
# Full public origin; localhost:3000 for local development, HTTPS origin when deployed.
APP_URL=http://localhost:3000
PORT=3000
# Required only for the corresponding provider's OAuth connection flow.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Optional server-only installed apps; keys are permanent .myshopify.com domains.
# Each entry must be bound to the owning Profit Tracker user ID. Tokens renew automatically.
# Example: {"store.myshopify.com":{"userId":1,"label":"My Store","clientId":"APP_CLIENT_ID","clientSecret":"APP_CLIENT_SECRET"}}
SHOPIFY_CLIENT_CREDENTIALS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional fallback exchange-rate setting.
EXCHANGE_RATE_EUR_USD=1.1588
